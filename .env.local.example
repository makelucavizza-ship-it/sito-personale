# Anthropic API Key — per il Tool Audit
ANTHROPIC_API_KEY=sk-ant-...

# Resend — per invio email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@lucavizza.it

# Open Day ITS (pagine non indicizzate /open-day e /open-day/vota)
OPEN_DAY_KEY=scegli-una-stringa-lunga-e-a-caso
# Redis per sincronizzare stato e voti tra le istanze serverless di Vercel.
# Vercel → Storage → Marketplace → un qualsiasi Redis (es. Upstash) → Connect:
# le due variabili vengono popolate in automatico dall'integrazione.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
